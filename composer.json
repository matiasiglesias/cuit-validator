{
  "name": "matiasiglesias/cuit-validator",
  "description": "Módulo de Validación de CUIT",
  "type": "library",
  "keywords": [
    "cuit",
    "validator",
    "afip",
    "argentina",
    "clave única de identificación tributaria",
    "laminas"
  ],
  "license": "MIT",
  "homepage": "https://github.com/matiasiglesias/cuit-validator",
  "support": {
    "source": "https://github.com/matiasiglesias/cuit-validator",
    "issues": "https://github.com/matiasiglesias/cuit-validator/issues"
  },
  "authors": [
    {
      "name": "Matias Iglesias",
      "email": "matiasiglesias@matiasiglesias.com.ar",
      "role": "Developer"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.1",
    "laminas/laminas-stdlib": "^3.0",
    "laminas/laminas-validator": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "CuitValidator\\": "src/CuitValidator/"
    },
    "classmap": [
      "./Module.php"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
